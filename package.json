{
  "name": "ansible-flow-designer",
  "displayName": "Ansible Flow Designer",
  "description": "Visual, top-down designer for Ansible automation flows: sketch typed nodes and ports, run a walking skeleton, then bind nodes to modules, roles and playbooks.",
  "version": "0.8.0",
  "publisher": "afd-dev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ansible",
    "automation",
    "flow",
    "designer",
    "awx"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.flow.yaml"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "afd.flowEditor",
        "displayName": "Ansible Flow Designer",
        "selector": [
          {
            "filenamePattern": "*.flow.yaml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "afd.newFlow",
        "title": "New Flow…",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.generate",
        "title": "Generate Playbook",
        "category": "Ansible Flow",
        "icon": "$(file-code)"
      },
      {
        "command": "afd.runSkeleton",
        "title": "Run as Skeleton (Check Mode)",
        "category": "Ansible Flow",
        "icon": "$(play)"
      },
      {
        "command": "afd.runReal",
        "title": "Run for Real…",
        "category": "Ansible Flow",
        "icon": "$(debug-alt)"
      },
      {
        "command": "afd.syntaxCheck",
        "title": "Check Generated Code (Syntax)",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.showAudit",
        "title": "Show Run Audit Log",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.tidyUp",
        "title": "Tidy Up Layout",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.validate",
        "title": "Validate Design",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.openAsText",
        "title": "Open as Text",
        "category": "Ansible Flow",
        "icon": "$(go-to-file)"
      },
      {
        "command": "afd.catalog.rebuild",
        "title": "Rebuild Module Catalog",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.awx.launch",
        "title": "Launch in AWX",
        "category": "Ansible Flow",
        "icon": "$(rocket)"
      },
      {
        "command": "afd.awx.setupTemplate",
        "title": "Set Up AWX Template",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.awx.setToken",
        "title": "Set AWX Token",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.awx.clearToken",
        "title": "Clear AWX Token",
        "category": "Ansible Flow"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "afd.runSkeleton",
          "when": "activeCustomEditorId == afd.flowEditor",
          "group": "navigation@1"
        },
        {
          "command": "afd.openAsText",
          "when": "activeCustomEditorId == afd.flowEditor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "afd.tidyUp",
          "when": "activeCustomEditorId == afd.flowEditor"
        },
        {
          "command": "afd.validate",
          "when": "activeCustomEditorId == afd.flowEditor"
        },
        {
          "command": "afd.openAsText",
          "when": "activeCustomEditorId == afd.flowEditor"
        },
        {
          "command": "afd.generate",
          "when": "activeCustomEditorId == afd.flowEditor || resourceFilename =~ /\\.flow\\.yaml$/"
        },
        {
          "command": "afd.runSkeleton",
          "when": "activeCustomEditorId == afd.flowEditor"
        },
        {
          "command": "afd.runReal",
          "when": "activeCustomEditorId == afd.flowEditor"
        },
        {
          "command": "afd.syntaxCheck",
          "when": "activeCustomEditorId == afd.flowEditor"
        }
      ]
    },
    "configuration": {
      "title": "Ansible Flow Designer",
      "properties": {
        "afd.codegen.onSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Write generated code to `generated/` next to the flow whenever a flow without errors is saved. Files edited by hand are never overwritten without asking."
        },
        "afd.environment.kind": {
          "type": "string",
          "enum": [
            "auto",
            "container",
            "local"
          ],
          "default": "auto",
          "scope": "resource",
          "markdownDescription": "Where Ansible runs. `auto`: a container when an image is set (here or in the Red Hat Ansible extension's execution environment settings), else a local interpreter (VS Code Remote, venv). Native Windows needs a container."
        },
        "afd.environment.image": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Execution environment image for the probe and runs, e.g. `registry.example.net/ee/netops:2.19`. Empty: use `ansible.executionEnvironment.image` when the Red Hat Ansible extension enables execution environments."
        },
        "afd.environment.containerEngine": {
          "type": "string",
          "enum": [
            "auto",
            "docker",
            "podman"
          ],
          "default": "auto",
          "scope": "resource",
          "description": "Container engine for the image (auto: the Red Hat Ansible setting, else docker)."
        },
        "afd.environment.containerOptions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Extra `docker run` / `podman run` arguments, one per item (e.g. `-v`, `~/.ssh:/home/ansible/.ssh:ro` for keys)."
        },
        "afd.environment.python": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Python with ansible-core 2.19+ for local mode. Empty: `ansible.python.interpreterPath`, else `python3`."
        },
        "afd.run.inventory": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "Inventory for runs, relative to the repository root. Empty: the default from `ansible.cfg`."
        },
        "afd.run.askVaultPassword": {
          "type": "string",
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "default": "auto",
          "scope": "resource",
          "markdownDescription": "Ask for the vault password before a run (`auto`: when the inventory or repository vars contain vault data). The password is used for that run only and never stored."
        },
        "afd.awx.url": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "markdownDescription": "AWX address for _Launch in AWX_, e.g. `https://awx.example.net`. The token is kept in VS Code's secret storage (_Set AWX Token_), never in settings."
        },
        "afd.awx.verifyTls": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Verify AWX's TLS certificate. Turn off only for a lab AWX with a self-signed certificate."
        }
      }
    },
    "taskDefinitions": [
      {
        "type": "afd-run",
        "required": [
          "flow"
        ],
        "properties": {
          "flow": {
            "type": "string",
            "description": "Flow key"
          },
          "mode": {
            "type": "string",
            "enum": [
              "check",
              "real"
            ]
          }
        }
      }
    ],
    "yamlValidation": [
      {
        "fileMatch": "*.flow.yaml",
        "url": "./schema/flow.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "node scripts/build.mjs --production",
    "test:int": "vscode-test"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "elkjs": "0.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "3.0.2",
    "yaml": "2.9.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
