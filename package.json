{
  "name": "ansible-flow-designer",
  "displayName": "Ansible Flow Designer",
  "description": "Visual, top-down designer for Ansible automation flows: sketch typed nodes and ports, run a walking skeleton, then bind nodes to modules, roles and playbooks.",
  "version": "0.1.0",
  "publisher": "afd-dev",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "ansible",
    "automation",
    "flow",
    "designer",
    "awx"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "workspaceContains:**/*.flow.yaml"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "afd.flowEditor",
        "displayName": "Ansible Flow Designer",
        "selector": [
          {
            "filenamePattern": "*.flow.yaml"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "afd.newFlow",
        "title": "New Flow…",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.tidyUp",
        "title": "Tidy Up Layout",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.validate",
        "title": "Validate Design",
        "category": "Ansible Flow"
      },
      {
        "command": "afd.openAsText",
        "title": "Open as Text",
        "category": "Ansible Flow",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "afd.openAsText",
          "when": "activeCustomEditorId == afd.flowEditor",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "afd.tidyUp",
          "when": "activeCustomEditorId == afd.flowEditor"
        },
        {
          "command": "afd.validate",
          "when": "activeCustomEditorId == afd.flowEditor"
        },
        {
          "command": "afd.openAsText",
          "when": "activeCustomEditorId == afd.flowEditor"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node scripts/build.mjs --production",
    "test:int": "vscode-test"
  },
  "dependencies": {
    "@vscode/codicons": "0.0.46-24",
    "@xyflow/react": "12.12.0",
    "ajv": "8.20.0",
    "elkjs": "0.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ulid": "3.0.2",
    "yaml": "2.9.1",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.140.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
