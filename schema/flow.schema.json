{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/flow.schema.json",
  "title": "Ansible flow designer document",
  "type": "object",
  "required": [
    "schema_version",
    "flow",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "flow": {
      "type": "object",
      "required": [
        "id",
        "key",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "key": {
          "$ref": "#/$defs/slug"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "goal": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "runtime": {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "awx_workflow",
                "awx_job",
                "ansible_playbook"
              ]
            },
            "template": {
              "type": "string"
            }
          }
        },
        "inputs": {
          "$ref": "#/$defs/contract"
        }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "layout": {
      "$ref": "#/$defs/layout"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node",
          "port",
          "kind"
        ],
        "properties": {
          "node": {
            "$ref": "#/$defs/ulid"
          },
          "port": {
            "type": "string"
          },
          "kind": {
            "const": "open_on_purpose"
          },
          "reason": {
            "type": "string"
          },
          "by": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "contract": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "enum": [
              "string",
              "integer",
              "boolean",
              "list",
              "dict",
              "host_list",
              "any"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "default": {},
          "from": {
            "type": "string",
            "description": "node_key.output_name, flow.input_name, or impl return path"
          }
        },
        "required": [
          "type"
        ]
      }
    },
    "port": {
      "enum": [
        "in",
        "ok_hosts",
        "failed_hosts",
        "unreachable",
        "unchanged",
        "always",
        "cancelled",
        "timeout",
        "undo",
        "true",
        "false",
        "approved",
        "rejected",
        "join"
      ],
      "description": "Parallel branch ports use the pattern branch_<n>"
    },
    "portref": {
      "type": "object",
      "required": [
        "node",
        "port"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/ulid"
        },
        "port": {
          "type": "string",
          "pattern": "^([a-z_]+|branch_[0-9]+)$"
        }
      },
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "from": {
          "$ref": "#/$defs/portref"
        },
        "to": {
          "$ref": "#/$defs/portref"
        }
      },
      "additionalProperties": false
    },
    "impl": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "enum": [
            "module",
            "role",
            "playbook"
          ]
        },
        "ref": {
          "type": "string"
        },
        "collection_version": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "register": {
          "type": "string"
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "key",
        "type",
        "title"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/ulid"
        },
        "key": {
          "$ref": "#/$defs/slug"
        },
        "type": {
          "enum": [
            "start",
            "end",
            "task",
            "subflow",
            "decision",
            "approval",
            "parallel",
            "join"
          ]
        },
        "title": {
          "type": "string"
        },
        "intent": {
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "specified",
            "implemented",
            "tested"
          ]
        },
        "inputs": {
          "$ref": "#/$defs/contract"
        },
        "outputs": {
          "$ref": "#/$defs/contract"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/port"
          },
          "description": "Optional ports enabled beyond the type defaults"
        },
        "impl": {
          "$ref": "#/$defs/impl"
        },
        "undo": {
          "$ref": "#/$defs/impl"
        },
        "condition": {
          "type": "string",
          "description": "Decision nodes: Jinja expression evaluated per host"
        },
        "outcome": {
          "enum": [
            "success",
            "failed"
          ],
          "description": "End nodes"
        },
        "settings": {
          "type": "object",
          "properties": {
            "max_fail_percentage": {
              "type": "number"
            },
            "serial": {
              "type": [
                "string",
                "integer"
              ]
            },
            "timeout": {
              "type": "string"
            },
            "retries": {
              "type": "integer"
            },
            "become": {
              "type": "boolean"
            },
            "credential": {
              "type": "string"
            },
            "execution_environment": {
              "type": "string"
            },
            "inventory_target": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "subflow": {
          "type": "object",
          "properties": {
            "nodes": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "edges": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/edge"
              }
            },
            "layout": {
              "$ref": "#/$defs/layout"
            },
            "boundary": {
              "type": "object",
              "properties": {
                "in": {
                  "$ref": "#/$defs/ulid"
                },
                "outputs": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/portref"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  }
}