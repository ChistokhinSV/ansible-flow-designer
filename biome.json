{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!ansible-flow-designer-handoff",
      "!examples",
      "!samples",
      "!schema",
      "!test/fixtures",
      "!docs/spikes",
      "!skills",
      "!docs/guide/reference/problems.md",
      "!docs/guide/reference/flow-format.md",
      "!instructions",
      "!probe",
      "!dist",
      "!out",
      "!.vscode-test"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "style": {
        "noDescendingSpecificity": "off"
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/core/**", "src/node/**", "src/mcp/**", "src/cli/**", "src/webview/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "The core, node, MCP, CLI and webview layers run without VS Code (AFD-37, ADR-0023): use src/extension for the vscode API."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "The core runs without VS Code (ADR-0023).",
                  "node:fs": "The core does no IO: take it as a parameter (ADR-0023).",
                  "node:fs/promises": "The core does no IO: take it as a parameter (ADR-0023).",
                  "node:child_process": "The core starts no processes (ADR-0023)."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/flow/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "vscode": "The core runs without VS Code (ADR-0023).",
                  "node:fs": "The core does no IO: take it as a parameter (ADR-0023).",
                  "node:fs/promises": "The core does no IO: take it as a parameter (ADR-0023).",
                  "node:child_process": "The core starts no processes (ADR-0023)."
                },
                "patterns": [
                  {
                    "group": ["../engine", "../engine/*"],
                    "message": "The flow model does not depend on an engine (AFD-40): the engine reads the model, not the other way round. Shared names live in core/flow (dataNames, segments)."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
