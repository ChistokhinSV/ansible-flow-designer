   "fqcn": "ansible.builtin.service",
   "collection": "ansible.builtin",
   "name": "service",
   "short_description": "Manage services",
   "description": "Starts, stops and restarts services.",
   "options": {
    "name": {
     "type": "str",
     "description": "Service name",
     "required": true
    },
    "state": {
     "type": "str",
     "description": "Wanted state",
     "choices": [
      "started",
      "stopped",
      "restarted",
      "reloaded"
     ]
    }
   },
   "returns": {},
   "examples": "",
   "attributes": {
    "check_mode": {
